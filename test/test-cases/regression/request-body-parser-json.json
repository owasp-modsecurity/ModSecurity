    "title": "V3-BASELINE-NATIVE-NUMBER: count names post and exact number text",
    "request": {
      "headers": {
        "Host": "baseline.invalid",
        "Content-Type": "application/json",
        "Content-Length": "11"
      },
      "uri": "/",
      "method": "POST",
      "body": [
        "{\"x\":1E+02}"
      ]
    },
    "expected": {
      "http_code": 418,
      "error_log": "V3-BASELINE-NATIVE-NUMBER"
    },
    "rules": [
      "SecRuleEngine On",
      "SecRequestBodyAccess On",
      "SecAction \"id:900001,phase:1,pass,nolog,ctl:requestBodyProcessor=JSON\"",
      "SecRule &ARGS \"@eq 1\" \"id:900002,phase:2,t:none,deny,status:418,log,msg:'V3-BASELINE-NATIVE-NUMBER',chain\"",
      "SecRule ARGS:json.x \"@streq 31452b3032\" \"t:none,t:hexEncode,chain\"",
      "SecRule ARGS_NAMES \"@streq json.x\" \"t:none,chain\"",
      "SecRule &ARGS_POST \"@eq 0\" \"t:none,chain\"",
      "SecRule REQBODY_ERROR \"@eq 0\" \"t:none\""
    ]
  },
