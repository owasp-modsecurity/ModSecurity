      "SecAuditLogParts ABCFHZ",
      "SecAuditLog /tmp/modsec_audit_issue_2672_1.log",
      "SecAuditLogDirMode 0766",
      "SecAuditLogFileMode 0666",
      "SecAuditLogType Serial",
      "SecAuditLogRelevantStatus \"^(?:5|4(?!04))\""
